# Docker Compose project name (optional)
COMPOSE_PROJECT_NAME=lemello-local

# Optional — local repo paths (used by compose/local-stack.yml)
BACKEND_CONTEXT=../backend
WEBAPP_CONTEXT=../webapp

# Optional — image tags (used if you tag images locally)
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# PostgreSQL (local)
POSTGRES_USER=lemello
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lemello
POSTGRES_PORT=5432

# Redis (local)
REDIS_PORT=6379
REDIS_PASSWORD=change_me_optional

# Backend / Frontend (local)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Shared connection strings (container-to-container URLs)
DATABASE_URL=postgresql://lemello:change_me_strong_password@postgres:5432/lemello
REDIS_URL=redis://:change_me_optional@redis:6379/0
